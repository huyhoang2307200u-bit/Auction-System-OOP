<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.2-ea" fx:controller="com.auction.controller.AuctionListController">
    <top>
        <VBox style="-fx-background-color: #2c3e50;">
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 15;">
                <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="HỆ THỐNG ĐẤU GIÁ TRỰC TUYẾN" />
            </HBox>
            <Label fx:id="userInfoLabel" style="-fx-text-fill: #ecf0f1; -fx-padding: 0 0 10 15; -fx-font-style: italic;" text="Xin chào: ..." />
        </VBox>
    </top>

    <left>
        <VBox prefWidth="210" style="-fx-background-color: #ecf0f1; -fx-padding: 10; -fx-spacing: 10;">
            <Button maxWidth="Infinity" style="-fx-alignment: CENTER_LEFT;" text="Danh sách đấu giá" />
            <Button fx:id="btnAddItem" maxWidth="Infinity" onAction="#handleOpenAddItem" style="-fx-alignment: CENTER_LEFT;" text="Quản lý sản phẩm" />
            <Button maxWidth="Infinity" onAction="#handleOpenHistory" style="-fx-alignment: CENTER_LEFT;" text="Lịch sử giao dịch" />

            <Separator />
            <Label text="Ví tài khoản" style="-fx-font-weight: bold;" />
            <Label fx:id="balanceLabel" text="Số dư ví: 0.00" />
            <TextField fx:id="depositAmountField" promptText="Số tiền cần nạp" />
            <Button fx:id="btnDeposit" maxWidth="Infinity" onAction="#handleDepositAction"
                    style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold;" text="Gửi yêu cầu nạp" />
            <Button fx:id="btnReviewDeposits" maxWidth="Infinity" onAction="#handleReviewDeposits"
                    style="-fx-background-color: #16a085; -fx-text-fill: white; -fx-font-weight: bold;" text="Duyệt yêu cầu nạp tiền" />
            <Label fx:id="pendingDepositLabel" wrapText="true" style="-fx-text-fill: #c0392b; -fx-font-weight: bold;" text="Không có yêu cầu nạp đang chờ." />

            <Separator />
            <Label text="Auto-Bidding" style="-fx-font-weight: bold;" />
            <TextField fx:id="autoMaxBidField" promptText="Giá tối đa" />
            <TextField fx:id="autoIncrementField" promptText="Bước giá" />
            <Button fx:id="btnAutoBid" maxWidth="Infinity" onAction="#handleAutoBidAction"
                    style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-weight: bold;" text="Bật auto-bid" />

            <Region VBox.vgrow="ALWAYS" />

            <Button maxWidth="Infinity" onAction="#handleOpenNewWindow"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                    text="Giả lập người dùng" />
        </VBox>
    </left>

    <center>
        <SplitPane orientation="VERTICAL">
            <VBox spacing="10" style="-fx-padding: 20;">
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Danh Sách Phiên Đấu Giá Đang Diễn Ra" />
                <TableView fx:id="itemTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="80" text="Mã" />
                        <TableColumn fx:id="colName" prefWidth="170" text="Tên sản phẩm" />
                        <TableColumn fx:id="colCurrentPrice" prefWidth="120" text="Giá hiện tại" />
                        <TableColumn fx:id="colHighestBidder" prefWidth="130" text="Người dẫn đầu" />
                        <TableColumn fx:id="colEndTime" prefWidth="130" text="Kết thúc" />
                        <TableColumn fx:id="colStatus" prefWidth="110" text="Trạng thái" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
            <VBox spacing="8" style="-fx-padding: 10 20 20 20;">
                <Label fx:id="selectedItemLabel" style="-fx-font-weight: bold;" text="Chưa chọn phiên" />
                <LineChart fx:id="priceChart" legendVisible="false" title="Biểu đồ giá realtime">
                    <xAxis>
                        <CategoryAxis label="Thời gian" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Giá cao nhất" />
                    </yAxis>
                </LineChart>
            </VBox>
        </SplitPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" prefHeight="70.0" spacing="15.0" style="-fx-padding: 15; -fx-background-color: #f4f4f4; -fx-border-color: #cccccc; -fx-border-width: 1 0 0 0;">
            <TextField fx:id="bidAmountField" prefHeight="35.0" prefWidth="170.0" promptText="Nhập giá đặt..." />
            <Button fx:id="btnBid" onAction="#handleBidAction" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="Đấu giá" />
            <Button fx:id="btnEndAuction" onAction="#handleEndAuction" prefHeight="35.0" prefWidth="130.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="Kết thúc phiên" />
        </HBox>
    </bottom>
</BorderPane>
