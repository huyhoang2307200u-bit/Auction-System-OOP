<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane stylesheets="@../css/style.css" styleClass="root" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.LoginController">
   <children>
      <VBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20.0">
               <children>
                  <!-- Logo bên trái -->
                  <ImageView fitHeight="150.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@/images/logo.png" />
                     </image>
                  </ImageView>

                  <!-- Form đăng nhập bên phải -->
                  <VBox alignment="CENTER" prefWidth="300.0" spacing="15.0">
                     <children>
                        <Label text="ĐĂNG NHẬP HỆ THỐNG" styleClass="header-label" style="-fx-text-fill: #d52525;" />

                        <TextField fx:id="usernameField" maxWidth="200.0" promptText="Tên đăng nhập" styleClass="text-field" />
                        <PasswordField fx:id="passwordField" maxWidth="200.0" promptText="Mật khẩu" styleClass="text-field" />

                        <Button fx:id="btnLogin" onAction="#handleLogin" prefWidth="200.0" text="Đăng Nhập" styleClass="button, btn-danger" />

                        <Separator maxWidth="200.0" />

                        <HBox alignment="CENTER" spacing="10.0">
                           <children>
                              <Button fx:id="btnRegister" onAction="#handleRegister" text="Tạo tài khoản" styleClass="button, btn-secondary" />
                              <Button fx:id="btnForgotPassword" text="Quên mật khẩu" styleClass="button, btn-secondary"/>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>